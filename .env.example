# ============================================================
# JobCatch backend — environment contract
# Copy to `.env` for local dev. NEVER commit the real .env.
# ============================================================

# --- Django core ---
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostGIS-enabled Postgres) ---
# Format: postgis://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgis://jobcatch:jobcatch@localhost:5432/jobcatch

# --- Redis (cache, Channels layer, Celery broker) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
JWT_SIGNING_KEY=change-me-separate-from-secret-key
ACCESS_TOKEN_LIFETIME_MIN=15
REFRESH_TOKEN_LIFETIME_DAYS=14

# --- CORS (client origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:19006

# --- Email (OTP + notifications). Console backend in dev. ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@jobcatchonline.com

# --- Payment gateways ---
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# The "Secret hash" you set in Flutterwave dashboard > Webhooks (sent as verif-hash).
FLUTTERWAVE_WEBHOOK_HASH=
# paystack | flutterwave
DEFAULT_PAYMENT_GATEWAY=paystack
PAYMENT_CALLBACK_URL=https://jobcatchonline.com/payments/callback
FRONTEND_URL=https://jobcatchonline.com

# --- Paid job listings ---
# False = jobs go live free, immediately
PAID_JOB_LISTINGS_ENABLED=True

# --- Employer KYC ---
KYC_REQUIRED_TO_POST_JOBS=True
# True = verify instantly when CAC+TIN+NIN all pass
KYC_AUTO_APPROVE=False
# manual | dojah
KYC_PROVIDER=manual
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
# sandbox: https://sandbox.dojah.io
DOJAH_BASE_URL=https://api.dojah.io
# Override only if Dojah changes its paths:
# DOJAH_CAC_PATH=/api/v1/kyc/cac/basic
# DOJAH_TIN_PATH=/api/v1/kyc/tin
# DOJAH_NIN_PATH=/api/v1/kyc/nin
# Private KYC documents (never served publicly). Defaults to <disk>/_private on Render.
# PRIVATE_MEDIA_ROOT=

# --- SMS for phone OTP ---
# console | termii
SMS_BACKEND=console
TERMII_API_KEY=
TERMII_SENDER_ID=JobCatch

# --- Prices (Naira) ---
ARTISAN_VERIFICATION_FEE=5000
SEEKER_PRO_PRICE=3000
SEEKER_PRO_PERIOD_DAYS=30

# --- WhatsApp job alerts (Meta WhatsApp Cloud API) ---
# console | cloud_api
WHATSAPP_BACKEND=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_JOB_ALERT_TEMPLATE=job_alert
WHATSAPP_TEMPLATE_LANG=en

# --- Bill payments (VTU.ng reseller account) ---
VTU_USERNAME=
VTU_PASSWORD=
# signs VTU.ng webhooks
VTU_USER_PIN=
# Optional flat fee per purchase, in Naira:
BILL_FEE_AIRTIME=0
BILL_FEE_DATA=0
BILL_FEE_ELECTRICITY=0
BILL_FEE_TV=0

# --- Object storage (S3-compatible) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=

# --- AI (Phase 3) ---
LLM_PROVIDER=            # e.g. anthropic | openai (abstraction picks impl)
LLM_API_KEY=

# --- Google Maps (Phase 3 geo) ---
GOOGLE_MAPS_API_KEY=
